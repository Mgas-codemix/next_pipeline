/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MODULES CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module-specific configuration for publish directories and arguments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Input Validation modules
    //
    withName: 'VALIDATE_FASTA' {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: 'VALIDATE_GTF' {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: 'VALIDATE_SAMPLESHEET' {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,csv}"
        ]
    }

    //
    // Annotation metrics modules
    //
    withName: 'COMPUTE_ANNOTATION_METRICS' {
        publishDir = [
            path: { "${params.outdir}/annotation_metrics" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    //
    // RNA-seq processing modules
    //
    withName: 'FASTP' {
        ext.args = '--qualified_quality_phred 20 --length_required 50'
        publishDir = [
            [
                path: { "${params.outdir}/rnaseq/fastp" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,html}"
            ],
            [
                path: { "${params.outdir}/rnaseq/fastp/trimmed" },
                mode: params.publish_dir_mode,
                pattern: "*.fastp.fastq.gz"
            ]
        ]
    }

    withName: 'MINIMAP2_INDEX' {
        ext.args = '-x sr'  // Short read mode
        publishDir = [
            path: { "${params.outdir}/rnaseq/index" },
            mode: params.publish_dir_mode,
            pattern: "*.mmi"
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args = '-ax sr'  // Short read mode with SAM output
        publishDir = [
            path: { "${params.outdir}/rnaseq/alignments" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }

    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [
            path: { "${params.outdir}/rnaseq/stats" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat"
        ]
    }

    //
    // Report generation
    //
    withName: 'GENERATE_REPORT' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,md}"
        ]
    }
}
