/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEST STUB CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for stub-mode testing (no actual tool execution)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test stub profile'
    config_profile_description = 'Stub test to verify pipeline structure without running tools'

    // Limit resources for testing
    max_cpus   = 1
    max_memory = '2.GB'
    max_time   = '1.h'

    // Input data for test
    input  = "${projectDir}/tests/data/samplesheet.csv"
    fasta  = "${projectDir}/tests/data/genome.fa"
    gtf    = "${projectDir}/tests/data/genes.gtf"

    // Output directory
    outdir = './results_stub'

    // Pipeline options
    run_rnaseq   = true
    top_contigs  = 5
}

// Enable stub mode
stubRun = true
